# Copy this file to .env.local and fill in the values from your
# DEVELOPMENT Supabase project (dutyholder-dev):
# Dashboard > Project Settings > API Keys / Data API.
# .env.local is ignored by git and must never be committed.

NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used only by the automated access-rule tests (npm test).
# Dashboard > Connect > Session pooler connection string, with your DB password.
# Point this at the DEV project only: tests create and roll back fake users.
DEV_DATABASE_URL=postgresql://postgres.your-dev-project-ref:password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Invite emails (phase 3). Server-only: never prefix these with NEXT_PUBLIC_.
# Without them, the Invite button shows a link for the owner to copy instead.
# RESEND_API_KEY from resend.com > API Keys; EMAIL_FROM must use a domain
# you have verified in Resend.
RESEND_API_KEY=re_xxx
EMAIL_FROM=Dutyholder <invites@your-verified-domain.co.uk>
# The site's public address, used in email links.
APP_URL=https://dutyholder.vercel.app

# Chasing engine (phase 5). Server-only.
# SUPABASE_SECRET_KEY: Supabase > Project Settings > API Keys > Secret key.
# Used ONLY by the scheduled chasing job (src/app/api/cron/chase).
SUPABASE_SECRET_KEY=sb_secret_xxx
# Any long random string; Vercel Cron sends it as "Authorization: Bearer ...".
CRON_SECRET=generate-a-long-random-string
